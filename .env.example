# ============================================================
#  K_middleware — 环境变量模板
#  用法: cp .env.example .env  然后填入真实值
#  .env 已在 .gitignore 中, 不会被提交
# ============================================================

# ---------- LLM (OpenAI 兼容协议) ----------
# 任何 OpenAI 兼容端点都能用: DeepSeek / 通义千问 / OpenAI / vLLM 本地部署
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# 如果要换回 Anthropic 官方, 改 app/config.py 里的 provider, 并设置:
# ANTHROPIC_API_KEY=sk-ant-xxxx

# ---------- PostgreSQL + pgvector (语义记忆) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=km_memory
POSTGRES_USER=km
POSTGRES_PASSWORD=km_dev_pwd

# ---------- MySQL (任务元信息 / 审计日志) ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=km_control
MYSQL_USER=km
MYSQL_PASSWORD=km_dev_pwd

# ---------- Redis (工作记忆 / 分布式锁 / 限流) ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- RocketMQ (Agent 长任务异步解耦) ----------
ROCKETMQ_NAMESRV=localhost:9876
ROCKETMQ_TOPIC_AGENT_TASK=km-agent-task

# ---------- MCP ----------
# Java 侧 MCP Server 的 Streamable HTTP 端点
MCP_ORDER_SERVER_URL=http://localhost:8081/mcp
# Agent 调用 MCP 网关时携带的鉴权 token (Phase2 接真实鉴权)
MCP_AUTH_TOKEN=dev-token
