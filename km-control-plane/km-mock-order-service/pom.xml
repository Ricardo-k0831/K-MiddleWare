<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.km</groupId>
        <artifactId>km-control-plane</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>km-mock-order-service</artifactId>
    <name>km-mock-order-service</name>
    <description>
        模拟"存量 Java 微服务"。它代表你公司里那套写了好几年、
        不可能为了接 AI 而改代码的业务系统。
        ★ 注意: 这个模块【故意】不依赖任何 Spring AI / MCP 相关的东西 ——
        存量服务零改造, 是这套架构的核心卖点, 代码上必须体现出来。
    </description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
