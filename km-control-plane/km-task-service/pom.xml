<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.km</groupId>
        <artifactId>km-control-plane</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>km-task-service</artifactId>
    <name>km-task-service</name>
    <description>
        任务生命周期管理。Agent 任务状态(state machine)的【唯一事实源】。

        和 km-mcp-server 的分工:
          km-mcp-server  —— 工具调用的安全边界 (Agent 能调什么)
          km-task-service —— 任务生命周期        (任务处于什么状态)

        拆成两个进程而不是合并, 是因为职责不同: 任务服务将来会被
        MQ 消费者 / 定时重试 / Grafana 同时打, 需要独立扩容。
    </description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          ★ Boot 4 专用 starter, 不是 boot3 那个 ★
          底层是 mybatis-spring 4.0.0 (对应 Spring Framework 7)。
          版本在父 pom 的 dependencyManagement 里统一管。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>

        <!-- 驱动版本由 Boot 的 BOM 管, 不用写 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- @Valid / @NotNull 等, 让参数校验在进 Service 之前就被拦掉 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
