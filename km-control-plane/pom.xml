<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ============================================================
         母亲 POM: 统一版本, 子模块不写版本号
         ============================================================ -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/>
    </parent>

    <groupId>com.km</groupId>
    <artifactId>km-control-plane</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>km-control-plane</name>
    <description>K_middleware Java 控制面 — MCP 工具网关 / 任务状态事实源 / 审计</description>

    <modules>
        <!--
          审计信封和投递器。排在最前面只是可读性考虑 —— Maven 的 reactor
          自己会按依赖关系排序, 不靠书写顺序。

          为什么现在才拆: 原计划 (见下面注释的原文) 是"等真需要了再拆",
          而"真需要"的时刻到了 —— km-mcp-server 也要发审计事件, 信封如果
          留在 km-task-service 里, 网关就得反向依赖任务服务。
        -->
        <module>km-audit-core</module>

        <!-- Phase1: 存量服务 mock + 把它包成 MCP 工具的门户 -->
        <module>km-mock-order-service</module>
        <module>km-mcp-server</module>
        <!-- Phase2: 任务生命周期管理, 状态机的事实源 -->
        <module>km-task-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Spring AI 2.0.1 依赖 io.modelcontextprotocol.sdk:mcp:2.0.0 -->
        <spring-ai.version>2.0.1</spring-ai.version>

        <!--
          ★ 注意是 boot4-starter, 不是 boot3-starter ★
          Spring Boot 4 跑在 Spring Framework 7 上, MyBatis 那条线也跟着换了:
            mybatis-plus-spring-boot3-starter -> mybatis-spring 3.x
            mybatis-plus-spring-boot4-starter -> mybatis-spring 4.0.0
          用错 starter 不会给出"版本不匹配"这种明确报错, 而是在启动装配阶段
          以各种奇怪的方式失败。
        -->
        <mybatis-plus.version>3.5.17</mybatis-plus.version>

        <!--
          ★ 用【原生】rocketmq-client, 不用 rocketmq-spring-boot-starter ★

          查过 starter 2.3.5 的父 pom: 它的 spring.boot.version 是 2.7.18,
          也就是按 Boot 2.7 编的。本项目跑 Boot 4.0.8 (Spring Framework 7),
          中间隔着 javax.* -> jakarta.* 那次改名, 直接拿过来用会以各种
          看不懂的方式炸 —— 和当初 mybatis boot3/boot4 starter 是同一类坑。

          原生 client 是纯 Java 库, 不依赖 Spring 的任何自动配置,
          版本对 Boot 无感。代价是收发要自己装配 (见 audit/AuditPublisher)。
          对控制面来说这反而是好事: 发送重试、线程模型、关停顺序都能自己控。

          版本选 5.3.x 是同 broker (5.3.1) 保持同一条发布线。
        -->
        <rocketmq.version>5.3.4</rocketmq.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
              ★ 坑: Spring AI 的版本【不在】 Spring Boot 的 BOM 里管理,
              必须自己 import spring-ai-bom, 否则子模块里写 <version> 会到处散落。
            -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- MyBatis-Plus 同样不在 Boot 的 BOM 里, 一样要自己管 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- RocketMQ 原生客户端, 理由见上面 properties 里的长注释 -->
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-client</artifactId>
                <version>${rocketmq.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
