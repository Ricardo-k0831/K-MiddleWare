<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.km</groupId>
        <artifactId>km-control-plane</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>km-mcp-server</artifactId>
    <name>km-mcp-server</name>
    <description>
        MCP 工具网关。把存量 Java 微服务包装成标准 MCP 工具暴露给 Python Agent。
        后续所有企业级能力(鉴权 / 限流 / 熔断 / 审计)都收敛在这一层,
        业务微服务不需要任何改动。
    </description>

    <dependencies>
        <!--
          spring-ai-starter-mcp-server-webmvc
            = Streamable HTTP 传输 (基于 Spring MVC, 同步模型)
          对应 artifact: spring-ai-autoconfigure-mcp-server-webmvc
          底层依赖: io.modelcontextprotocol.sdk:mcp:2.0.0
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <!-- 调用存量微服务用。RestClient 是 Spring 6.1+ 引入的同步阻塞客户端,
             比 RestTemplate 更现代, 也不用像 WebClient 那样为它引入响应式栈。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          ★ Spring Boot 4 的迁移坑 ★
          Boot 4 把自动配置做了模块化拆分, spring-boot-starter-web 现在【只】包含
          jackson / tomcat / http-converter / webmvc —— 不再包含 RestClient。

          少了这个依赖, 启动时会报:
            No qualifying bean of type 'org.springframework.web.client.RestClient$Builder'

          这个 starter 提供自动配置好的 RestClient.Builder (已装配好消息转换器),
          所以代码里可以直接注入 Builder 而不用自己 new。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>

        <!--
          审计信封 + 投递器。网关是四层里【第二层】采集点
          (MCP_GATEWAY / LEGACY_SERVICE), 往同一个 KM_AUDIT topic 发。

          注意它带来的是 rocketmq-client, 也就是网关从此【自己直连 broker】,
          不再经过 km-task-service 转发 —— 网关是 Java, 直连没有障碍
          (Python 那边才必须走 HTTP, 理由见 km-local-dev-env-traps)。
        -->
        <dependency>
            <groupId>com.km</groupId>
            <artifactId>km-audit-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
          限流的存储。★ 限流状态必须放在进程外 ★
          网关的计数器一旦在 JVM 内存里, 多实例部署时每个实例各限各的,
          实际放行量 = 实例数 × 配置值 —— 配置看起来生效了, 但后端承受的
          流量是 N 倍。Redis + Lua 让"读-改-写"在一个原子操作里完成。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
          ★ 为什么用 core 而不是 resilience4j-spring-boot3 starter ★
          starter 是给 Boot 3 写的, 它通过自动配置注册 AOP 切面并读
          spring-boot3 专用的配置前缀; 本项目是 Boot 4, 版本对不上时
          最坏的情况是"配置没读进去、切面静默不生效" —— 熔断看着开着,
          实际一次都没拦。core 模块没有 Spring 依赖, 由我们自己 new
          一个 CircuitBreaker, 配置绑定也自己写, 行为完全可预期。

          只引 circuitbreaker: 限流用 Redis Lua, 不需要 ratelimiter 模块;
          重试已经在任务服务 (RetryScheduler) 里有了, 不需要 retry 模块。
        -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
